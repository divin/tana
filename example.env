JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=replace-with-a-jellyfin-api-key
JELLYFIN_USER_ID=00000000-0000-0000-0000-000000000000
TZ=Europe/Berlin
SYNC_TIME=03:00
# Fraction of runtime (0.5-1.0) a PlaybackStop must reach to count as completed
# when Jellyfin's PlayedToCompletion flag is not set. Default 1.0.
PLAYBACK_COMPLETION_THRESHOLD=1.0
LOG_LEVEL=INFO
