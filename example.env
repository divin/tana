JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=replace-with-a-jellyfin-api-key
JELLYFIN_USER_ID=00000000-0000-0000-0000-000000000000
TZ=Europe/Berlin
SYNC_TIME=03:00
# Fraction of runtime (0.5-1.0) a playback must reach to count as completed
# when Jellyfin's Played flag is not set. Default 1.0.
PLAYBACK_COMPLETION_THRESHOLD=1.0
# Whether to read the Jellyfin admin activity log (exact playback dates within
# the server's retention window). Requires an API key with dashboard access;
# the sync falls back to per-item play state when the key gets HTTP 403.
#JELLYFIN_ACTIVITY_LOG_ENABLED=true
LOG_LEVEL=INFO
